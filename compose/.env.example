# ---- 通用 ----
TZ=Asia/Shanghai
PUID=1000
PGID=1000

# ---- 端口 ----
MC_PORT=3000
QB_PORT=8080
EMBY_PORT=8096

# ---- 目录（改成 NAS 上的实际路径；没改时用仓库内相对目录）----
# 媒体目录：MovieClaw 本地库（PT 入库）与 p115-library 生成的 STRM 都放这里
MEDIA_DIR=./media
# qBittorrent 下载目录：PT 种子先到这里，再入库
DOWNLOAD_DIR=./downloads

# ---- 镜像版本（sync-upstream.ps1 会自动更新 MOVIECLAW_TAG）----
# 默认官方镜像；用本仓库 Actions 构建的镜像时改成 ghcr.io/xueyue110/movieclaw
MOVIECLAW_IMAGE=movieclaw/movieclaw
MOVIECLAW_TAG=v0.50.0
QB_TAG=latest
EMBY_TAG=latest
